var PRECACHE = 'precache-{{ pwaVersion }}';
var RUNTIME = 'runtime-{{ pwaVersion }}';
var HOSTNAME = '{{ hostName }}';

{% set _debug = app.debug or pwaDebug %}

{% if _debug %}
console.log(self.registration);
{% endif %}

{# list the files you want cached by the service worker under "PRECACHE" #}
{#
PRECACHE_URLS = [
    '{{ path('aurora_pwa_offline')|raw }}'
];
#}

{# JSON arrays, see AuroraPWA::serviceWorkerJS() #}
PRECACHE_URLS = {{ precache|raw }};

{# Installing - the rest below handles the installing and caching #}
self.addEventListener('install', event => {
    {# Do NOT call skipWaiting() here: the new worker must stay in "waiting" until the user #}
    {# accepts the update (the page posts a SKIP_WAITING message - see the 'message' handler #}
    {# below). Activating eagerly here would leave registration.waiting null by the time the #}
    {# update prompt is shown, so the prompt's "Reload" button would have nothing to activate. #}
    event.waitUntil(
        caches.open(PRECACHE).then(cache => cache.addAll(PRECACHE_URLS))
    );
});

{# Active #}
self.addEventListener('activate', event => {
    const currentCaches = [PRECACHE, RUNTIME];
    event.waitUntil(
        caches.keys().then(cacheNames => {
            return cacheNames.filter(cacheName => !currentCaches.includes(cacheName));
        }).then(cachesToDelete => {
            return Promise.all(cachesToDelete.map(cacheToDelete => {
                return caches.delete(cacheToDelete);
            }));
        }).then(() => self.clients.claim())
    );
});

{# Fetch handler Put your logic here #}
self.addEventListener('fetch', event => {
    {% if _debug %}
    console.log(event.request.url);
    {% endif %}

    if (event.request.method === 'POST') {
        {% if _debug %}console.log('Prevent caching: POST request');{% endif %}
        return false;
    }

    if (event.request.headers.get('X-Pwa-Prevent-Cache')) {
        {% if _debug %}console.log('Prevent caching the request (X-pwa-prevent-cache header)');{% endif %}
        return false;
    }

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    var preventCacheHeaderRequestAccept = {{ prevent_cache_header_request_accept|raw }};

    {# https://developer.mozilla.org/en-US/docs/Web/API/Cache/match #}
    for (var k = 0; k < preventCacheHeaderRequestAccept.length; k++) {
        if (preventCacheHeaderRequestAccept[k].length > 0 && event.request.headers.get('accept').includes(preventCacheHeaderRequestAccept[k])) {
            {% if _debug %}console.log('Prevent caching: header accept: ' + preventCacheHeaderRequestAccept[k]);{% endif %}
            return false;
        }
    }

    {# ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ #}

    {# ['/ajax-requests', '/q', '/xhr', ..] #}
    var startsWith = {{ prevent_cache|raw }};

    for (var i = 0; i < startsWith.length; i++) {
        if (event.request.url.startsWith(self.location.origin) && event.request.url.match(startsWith[i])) {
            {% if _debug %}console.log('Prevent caching: ' + startsWith[i]);{% endif %}
            return false;
        }
    }

    {# ['fonts.gstatic.com', 'fonts.googleapis.com'] (patterns, see matchInArray()) #}
    var externalCache = {{ external_cache|raw }};

    var sameOrigin = event.request.url.startsWith(self.location.origin);

    if (sameOrigin || matchInArray(event.request.url, externalCache)) {
        {# Pages are loaded from the network first, the cache is only their offline fallback. Served from the cache first, a page #}
        {# stayed outdated until the next deploy, and the page of a signed-in user was shown again after the logout, also to the #}
        {# next user of the browser. #}
        const isNavigation = 'navigate' === event.request.mode;

        event.respondWith((async () => {
            try {
                {# Try to return from the cache, only a response that may be reused: the precached URLs are stored whatever their #}
                {# Cache-Control, e.g. the page of the user signed in at the installation, then fetched by Turbo (not a navigation). #}
                if (!isNavigation) {
                    const cachedResponse = await caches.match(event.request);
                    if (cachedResponse && mayBeReused(cachedResponse)) {
                        return cachedResponse;
                    }
                }

                {# If it's not in the cache, get it from the network. #}
                const response = await fetch(event.request);

                if (isCacheable(event.request, response, sameOrigin)) {
                    {# Best-effort: when the Cache Storage fails (full, unavailable), the network response is still returned, #}
                    {# instead of a stale cached page or the offline page. #}
                    try {
                        const cache = await caches.open(RUNTIME);
                        {# Put a copy of the response in the cache. #}
                        await cache.put(event.request, response.clone());
                    } catch (cacheError) {
                        {% if _debug %}console.log('Caching failed: ' + cacheError);{% endif %}
                    }
                }

                return response;
            } catch (err) {
                if (isNavigation) {
                    {# Only a page that may be reused: the precached pages (the start URL, "aurora.pwa.precache") are stored #}
                    {# whatever their Cache-Control, e.g. the page of the user signed in when the service worker was installed. #}
                    const cachedPage = await caches.match(event.request);
                    if (cachedPage && mayBeReused(cachedPage)) {
                        return cachedPage;
                    }
                }

                {# https://web.dev/learn/pwa/caching/#generic_fallback #}
                {# In case of a network error, return the precached offline page ("aurora.pwa.offline") when present. #}
                const offlineResponse = await caches.match({{ offline|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }});
                if (offlineResponse) {
                    return offlineResponse;
                }

                {# Last-resort fallback so respondWith() never resolves with undefined. #}
                return new Response('', {status: 504, statusText: 'Gateway Timeout'});
            }
        })());
    }
});

{# Only store complete GET responses. Caching partial (206), error, or #}
{# unexpected responses would poison the cache. For same-origin requests we #}
{# require a successful "basic" response; for the allow-listed external hosts #}
{# we also accept "opaque" (no-cors) responses, which cannot be introspected. #}
{# A response that must not be reused is not stored either (see mayBeReused()). #}
function isCacheable(request, response, sameOrigin) {
    if ('GET' !== request.method || !response || 206 === response.status || !mayBeReused(response)) {
        return false;
    }

    return (sameOrigin && response.ok && 'basic' === response.type) ||
        (!sameOrigin && (response.ok || 'opaque' === response.type));
}

{# "Cache-Control: no-store / no-cache / private" (the default of the Symfony responses): the response is personal (e.g. the page #}
{# of a signed-in user) or must be revalidated, so it must not be reused. #}
function mayBeReused(response) {
    var cacheControl = (response.headers.get('Cache-Control') || '').toLowerCase();

    return !/(^|[\s,])(no-store|no-cache|private)([\s,=]|$)/.test(cacheControl);
}

function matchInArray(string, expressions) {
    var len = expressions.length, i = 0;
    for (; i < len; i++) {
        if (string.match(expressions[i])) {
            return true;
        }
    }
    return false;
};

self.addEventListener('message', event => {
    if (event.data && event.data.type === 'SKIP_WAITING') {
        self.skipWaiting();
    }
});

