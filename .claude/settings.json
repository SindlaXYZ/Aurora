      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(for:*)",
      "Bash(gh release *)",
      "Bash(gh --version)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(mkdir:*)",
      "Bash(php bin/console:*)",
      "Bash(printf:*)",
      "Bash(tail:*)",
      "WebFetch(*)",
      "WebFetch(domain:ai.symfony.com)",
      "WebFetch(domain:api-platform.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.proxy-cheap.com)",
      "WebFetch(domain:github.com)",
