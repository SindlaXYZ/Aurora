{
    "name": "sindla/aurora",
    "type": "symfony-bundle",
    "description": "Aurora - Symfony 7.3 bundle",
    "keywords": [
    ],
    "homepage": "https://sindla.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Sindla XYZ S.R.L."
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-ctype": "*",
        "ext-gmp": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "ext-tokenizer": "*",
        "ext-zend-opcache": "*",
        "aws/aws-sdk-php": "^3.362",
        "brick/math": "^0.14",
        "doctrine/orm": "^3.5",
        "firebase/php-jwt": "^6.11",
        "geoip2/geoip2": "^3.2",
        "matthiasmullie/minify": "^1.3",
        "scienta/doctrine-json-functions": "^6.3",
        "symfony/uid": "^7.3",
        "symfony/property-info": "^7.3",
        "tedivm/jshrink": "^1.8"
    },
    "@comment require": [
        "no comments at this moment"
    ],
    "autoload": {
        "psr-4": {
            "Sindla\\Bundle\\AuroraBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Sindla\\Bundle\\AuroraBundle\\": "src/"
        }
    },
    "suggest": {
        "sindla/aurora": "no suggestions at this moment"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.4"
    }
}
